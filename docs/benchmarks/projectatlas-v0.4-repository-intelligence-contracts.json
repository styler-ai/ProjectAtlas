  "architecture_decisions": [
    {
      "id": "ADR-04-01",
      "status": "provisional",
      "topic": "parser_host",
      "decision": "Keep trusted core parsers in the default runtime and execute broad grammar artifacts only in a separately installed supervised pack process; select WASM without WASI capabilities or a vetted native worker only from the registered comparison.",
      "alternative": "runtime compilation or unverified in-process dynamic libraries",
      "risk": "pack isolation can cost throughput",
      "verification": "real-process correctness, containment, timeout, RSS, and throughput gates",
      "blocking_evidence": ["ARRI-2.14 parser-host benchmark and containment decision"]
    },
    {
      "id": "ADR-04-02",
      "status": "accepted",
      "topic": "typed_graph_layout",
      "decision": "Own closed graph identities, relations, evidence, coverage, and limits as Rust types and use typed SQLite rows; select arenas, interning, and internal numeric layouts only where profiles justify them.",
      "alternative": "generic object graph and JSON property bags",
      "risk": "schema migrations require deliberate compatibility work",
      "verification": "typed fixtures, migration reconciliation, canonical snapshot equivalence, and profiles"
    },
    {
      "id": "ADR-04-03",
      "status": "provisional",
      "topic": "fts_acceleration",
      "decision": "Keep deterministic lexical matching authoritative and permit FTS5 only as a preflighted candidate accelerator with exact verification and an honest fallback reason.",
      "alternative": "make FTS availability or ranking authoritative",
      "risk": "unsupported query classes can create false negatives",
      "verification": "with-without differential tests for literal, regex, fuzzy, Unicode, punctuation, and short queries",
      "blocking_evidence": ["ARRI-2.12 FTS completeness, cost, and latency benchmark"]
    },
    {
      "id": "ADR-04-04",
      "status": "accepted",
      "topic": "publication",
      "decision": "Publish structural and lexical derived data through exactly two live slots and monotonically advancing epochs; full scans stage separately and flip atomically, while incremental updates change only affected rows in one transaction.",
      "alternative": "whole-graph rewrite or append-only overlay chain",
      "risk": "slot reconciliation defects can expose stale or partial data",
      "verification": "failure injection, full-incremental equivalence, rollback, and concurrent reader tests"
    },
    {
      "id": "ADR-04-05",
      "status": "accepted",
      "topic": "semantic_provider_boundary",
      "decision": "Use normalized typed facts plus small language-owned resolution providers; keep common logic concrete and add a narrow trait only for the demonstrated provider boundary.",
      "alternative": "one handwritten pseudo-language-server hierarchy",
      "risk": "shared interfaces can accumulate language branches",
      "verification": "provider-local positive, negative, ambiguity, malformed, external, and cross-file tests"
    },
    {
      "id": "ADR-04-06",
      "status": "accepted",
      "topic": "optional_semantic_pack",
      "decision": "Keep ANN, model, tokenizer, preprocessing, and vector storage in a separately installed pack that is disabled by default and never blocks structural publication; no backend or model is selected before labeled evaluation.",
      "alternative": "bundle a model and linearly scan every vector",
      "risk": "optional complexity may not improve agent outcomes",
      "verification": "labeled retrieval, lifecycle, resource, offline, removal, and cross-platform gates"
    },
    {
      "id": "ADR-04-07",
      "status": "provisional",
      "topic": "benchmark_corpus_and_hardware",
      "decision": "Use immutable public small, medium, and large corpus commits; record local hosts as ineligible observations until a release runner class and calibration envelope are pinned before results, and compare paired runs on the same host without dividing latency by calibration.",
      "alternative": "single workstation timing or post-result normalization",
      "risk": "host variance can dominate small latency differences",
      "verification": "manifest validation, paired repetitions, raw timings, and eligibility checks",
      "blocking_evidence": ["ARRI-2.5 corpus pins", "ARRI-2.11 eligible runner and calibration envelope"]
    },
    {
      "id": "ADR-04-08",
      "status": "accepted",
      "topic": "rollback_retention",
      "decision": "Retain exactly the previously active full-publication slot until the next successful full publication needs it or explicit bounded cleanup removes eligibility; authored data remains outside derived slots.",
      "alternative": "unbounded historical slot chains",
      "risk": "the retained slot is not arbitrary point-in-time history",
      "verification": "rollback eligibility, reuse, cleanup, and authored-row preservation tests"
    }
  ],
