#!/bin/sh
# Purpose: Run the full local ProjectAtlas check suite before pushing.

set -e

# Git exports repository-local state to hooks; test fixtures must rediscover their own roots.
for git_variable in $(git rev-parse --local-env-vars); do
  unset "$git_variable"
done

python3 .github/scripts/verify-rust-toolchain.py
cargo run --locked -p projectatlas-lints --bin cargo-projectatlas-lints -- strict-strings
python3 docs/benchmarks/harness/mcp_composition.py --self-test
python3 .github/scripts/verify-manual-benchmark-policy.py
python3 .github/scripts/verify-published-benchmark-locks.py
cargo fmt --all --check
cargo check --workspace --all-targets --all-features --locked
cargo clippy --workspace --all-targets --all-features --locked -- -D warnings
cargo deny --locked --all-features check -D warnings
npm ci --ignore-scripts --prefix .github/mermaid-parser
npm audit --omit=dev --audit-level=moderate --prefix .github/mermaid-parser
cargo test --workspace --all-features --locked
cargo test --doc --workspace --all-features --locked
RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --all-features --locked
python3 .github/scripts/issue-checklists.py --self-test
python3 .github/scripts/test-optional-parser-proof-inputs.py
command -v gh >/dev/null 2>&1
repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"
push_scope="$(
  awk '
    NF != 4 { invalid=1; next }
    {
      seen=1
      if ($3 !~ /^refs\/heads\/[^[:space:]]+$/) invalid=1
      if ($3 == "refs/heads/main") main=1
    }
    END {
      if (!seen || invalid) exit 1
      if (main) print "global"
      else print "candidate"
    }
  '
)"
if [ "$push_scope" = "global" ]; then
  python3 .github/scripts/issue-checklists.py \
    --repo "$repo" --root . --issue-map openspec/issue-map.json
elif [ "$push_scope" = "candidate" ]; then
  if ! accepted_base="$(git merge-base origin/main HEAD)" || [ -z "$accepted_base" ]; then
    echo "candidate branch accepted origin/main base is unreadable" >&2
    exit 1
  fi
  if ! owner_issue="$(
    git log --format=%s "$accepted_base..HEAD" |
      python3 .github/scripts/issue-checklists.py --owner-from-commits
  )"; then
    echo "candidate branch owner resolution failed" >&2
    exit 1
  fi
  python3 .github/scripts/issue-checklists.py \
    --repo "$repo" --root . --issue-map openspec/issue-map.json \
    --candidate-issue "$owner_issue" --base "$accepted_base"
else
  echo "pre-push validation scope is invalid" >&2
  exit 1
fi
cargo run --locked -p projectatlas-cli -- --format json scan .
cargo run --locked -p projectatlas-cli -- lint --report-untracked --purpose-level low
