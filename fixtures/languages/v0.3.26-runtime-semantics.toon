schema_version: 1
baseline_release: v0.3.26
adapter_precedence_disposition: intentional-correction
adapter_precedence_rationale: "A supplied canonical language owns symbol routing; exact path inference applies only when language is absent."
extension_normalization_disposition: intentional-correction
extension_normalization_rationale: "Declared compound extensions match ASCII case-insensitively before ordinary extension fallback."
